NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/recylight?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://recylight-recy-light.vercel.app
ADMIN_NAME=RecyLight Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
CURRENCY=RWF
